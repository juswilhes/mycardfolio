# Auf dem Server nach ".env" kopieren und ausfuellen (NICHT ins Git).
NODE_ENV=production
DATABASE_PATH=/data/data.sqlite
FRONTEND_URL=https://mycardfolio.de
CORS_ORIGIN=https://mycardfolio.de,https://www.mycardfolio.de
TRUST_PROXY=1
PORT=3001

# Neue Registrierungen zulassen? Auf false = geschlossen (bestehende
# Nutzer koennen sich weiter anmelden).
REGISTRATION_OPEN=false

# --- E-Mail (IONOS-SMTP) -------------------------------------------
# Ohne diese Werte gehen Mails (Passwort-Reset, Bestaetigung, Tagesbericht)
# nur ins Log. Passwort = das Passwort des Postfachs info@mycardfolio.de.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=587
SMTP_USER=info@mycardfolio.de
SMTP_PASS=HIER_DAS_POSTFACH_PASSWORT
MAIL_FROM=mycardfolio <info@mycardfolio.de>
# Empfaenger des taeglichen Berichts. Dieses Konto gilt als "Betreiber" –
# seine eigene Aktivitaet wird aus dem Bericht herausgerechnet.
ADMIN_EMAIL=info@mycardfolio.de
# Optional: eigene IP-Adressen (kommagetrennt) – Zugriffe von hier zaehlen
# auch ohne Login nicht als fremde Besucher. Eigene IP: z.B. https://ifconfig.me
# ADMIN_IPS=

# Optional: eigener API-Key fuer die Pokemon TCG API (hoeheres Limit)
# POKEMONTCG_API_KEY=
