PORT=3001

# Optional, erhöht das Rate-Limit der Pokemon TCG API (kostenlos registrieren auf pokemontcg.io)
POKEMONTCG_API_KEY=

# --- Betrieb / Sicherheit ---------------------------------------------
# Erlaubte Frontend-Herkunft/-Herkünfte (kommagetrennt). Leer = alles
# erlauben (nur lokale Entwicklung).
# CORS_ORIGIN=https://mycardfolio.de,https://www.mycardfolio.de

# Anzahl Proxy-Hops, denen X-Forwarded-For vertraut wird (hinter nginx/
# Cloudflare i.d.R. 1). Leer = kein Proxy.
# TRUST_PROXY=1

# API-Anfragen pro IP je 15 Minuten (Standard 1000).
# RATE_LIMIT=1000
# Auth-Versuche (Login/Registrierung) pro IP je 15 Minuten (Standard 20).
# AUTH_RATE_LIMIT=20
