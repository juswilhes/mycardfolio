PORT=3001

# Optional, erhöht das Rate-Limit der Pokemon TCG API (kostenlos registrieren auf pokemontcg.io)
POKEMONTCG_API_KEY=

# --- Betrieb / Sicherheit ---------------------------------------------
# Erlaubte Frontend-Herkunft/-Herkünfte (kommagetrennt). Leer = alles
# erlauben (nur lokale Entwicklung).
# CORS_ORIGIN=https://mycardfolio.de,https://www.mycardfolio.de

# Anzahl Proxy-Hops, denen X-Forwarded-For vertraut wird (hinter nginx/
# Cloudflare i.d.R. 1). Leer = kein Proxy.
# TRUST_PROXY=1

# API-Anfragen pro IP je 15 Minuten (Standard 1000).
# RATE_LIMIT=1000
# Auth-Versuche (Login/Registrierung) pro IP je 15 Minuten (Standard 20).
# AUTH_RATE_LIMIT=20

# --- Konten ----------------------------------------------------------
# Basis-URL des Frontends fuer Links in E-Mails (Bestaetigung, Reset).
# FRONTEND_URL=https://mycardfolio.de

# NODE_ENV=production setzt das Session-Cookie auf "Secure" (nur HTTPS).
# NODE_ENV=production

# --- Produktion ----------------------------------------------------
# Persistenter Speicherort der SQLite-Datei (z. B. gemountetes Volume).
# DATABASE_PATH=/data/data.sqlite
# Pfad zum gebauten Frontend (Standard: ../frontend/dist neben backend/).
# FRONTEND_DIST=/app/backend/frontend/dist

# E-Mail des Seed-Kontos, dem beim ersten Start vorhandene Alt-Daten
# zugeordnet werden (nur beim allerersten Start relevant).
# SEED_USER_EMAIL=justus-hess@outlook.de

# Neue Registrierungen zulassen (Standard: ja). REGISTRATION_OPEN=false
# schliesst die Registrierung; bestehende Nutzer bleiben unberuehrt.
# REGISTRATION_OPEN=true

# --- E-Mail-Versand (optional; ohne = Mails nur ins Log) ------------
# SMTP_HOST=smtp.ionos.de
# SMTP_PORT=587
# SMTP_USER=info@mycardfolio.de
# SMTP_PASS=
# MAIL_FROM=mycardfolio <info@mycardfolio.de>
# ADMIN_EMAIL=info@mycardfolio.de   # Empfaenger + gilt als "Betreiber" (aus Bericht rausgefiltert)
# ADMIN_IPS=                         # optional, eigene IPs (kommagetrennt) fuer Zugriffe ohne Login

# --- Marktplatz (Stripe Connect) --------------------------------------
# Ohne STRIPE_SECRET_KEY bleibt der Marktplatz inaktiv (503), stuerzt aber
# nicht ab. Stripe-Konto unter https://dashboard.stripe.com/register
# anlegen, dann Connect aktivieren (dashboard.stripe.com/connect/overview).
# Zum Testen erstmal die Test-Keys (sk_test_...) verwenden.
# STRIPE_SECRET_KEY=sk_test_...
# Webhook unter dashboard.stripe.com/webhooks anlegen, Ziel-URL
# https://mycardfolio.de/api/marketplace/webhook, Events "checkout.session.completed"
# und "account.updated" auswaehlen - das Secret (whsec_...) hier eintragen.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Provision von mycardfolio auf jeden Verkauf, in Prozent (Standard 8).
# MARKETPLACE_FEE_PERCENT=8
