PORT=3001

# Optional, erhöht das Rate-Limit der Pokemon TCG API (kostenlos registrieren auf pokemontcg.io)
POKEMONTCG_API_KEY=

# --- Betrieb / Sicherheit ---------------------------------------------
# Erlaubte Frontend-Herkunft/-Herkünfte (kommagetrennt). Leer = alles
# erlauben (nur lokale Entwicklung).
# CORS_ORIGIN=https://mycardfolio.de,https://www.mycardfolio.de

# Anzahl Proxy-Hops, denen X-Forwarded-For vertraut wird (hinter nginx/
# Cloudflare i.d.R. 1). Leer = kein Proxy.
# TRUST_PROXY=1

# API-Anfragen pro IP je 15 Minuten (Standard 1000).
# RATE_LIMIT=1000
# Auth-Versuche (Login/Registrierung) pro IP je 15 Minuten (Standard 20).
# AUTH_RATE_LIMIT=20

# --- Konten ----------------------------------------------------------
# Basis-URL des Frontends fuer Links in E-Mails (Bestaetigung, Reset).
# FRONTEND_URL=https://mycardfolio.de

# NODE_ENV=production setzt das Session-Cookie auf "Secure" (nur HTTPS).
# NODE_ENV=production

# --- Produktion ----------------------------------------------------
# Persistenter Speicherort der SQLite-Datei (z. B. gemountetes Volume).
# DATABASE_PATH=/data/data.sqlite
# Pfad zum gebauten Frontend (Standard: ../frontend/dist neben backend/).
# FRONTEND_DIST=/app/backend/frontend/dist

# E-Mail des Seed-Kontos, dem beim ersten Start vorhandene Alt-Daten
# zugeordnet werden (nur beim allerersten Start relevant).
# SEED_USER_EMAIL=justus-hess@outlook.de
